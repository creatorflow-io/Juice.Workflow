{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EventBus": {
    "Connections": {
      "RabbitMQ": {
        "Connection": null,
        "Port": 5672,
        "VirtualHost": null,
        "UserName": null,
        "Password": null,
        "ConnectionMaxRetries": 5
      }
    },
    "PublishingPolicies": {
      "Default": {
        "Publishers": [
          {
            "Key": "rabbitmq",
            "Destination": "default_exchange"
          }
        ]
      },
      "Rules": [
        {
          "Priority": 600,
          "Match": {
            "Domain": "Workflows"
          },
          "Publishers": [
            {
              "Key": "rabbitmq",
              "Destination": "x.workflow.integration"
            }
          ]
        },
        {
          "Priority": 0,
          "Match": {},
          "Publishers": [
            {
              "Key": "rabbitmq",
              "Destination": "default_exchange"
            }
          ]
        }
      ]
    },
    "DeliveryPolicies": {
      "DefaultPolicy": {
        "Interval": "00:00:05",
        "BatchSize": 10,
        "Timeout": "00:05:00",
        "InitialRetryDelay": "00:00:05",
        "RetryDelayMultiplier": 2.0,
        "MaxRetryAttempts": 3
      },
      "Policies": {
        "rabbitmq__send-pending__*": {
          "Interval": "00:00:01",
          "BatchSize": 20
        },
        "rabbitmq__retry-failed__*": {
          "InitialRetryDelay": "00:00:10",
          "MaxRetryAttempts": 5
        },
        "*__recover-timeout__*": {
          "Timeout": "00:10:00"
        }
      }
    },
    "ConsumerRetryPolicies": {
      "Policies": [
        {
          "Source": "x.logs",
          "DeadLetterDest": "x.logs.retry",
          "RetryTiers": [ "retry.1s", "retry.1s1", "retry.1s2" ]
        }
      ]
    }
  }
}
